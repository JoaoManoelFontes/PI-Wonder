# =========================
# Spring
# =========================

CORE_SPRING_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=development
APP_PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8081

# =========================
# PostgreSQL
# =========================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wonder_db
POSTGRES_USER=wonder
POSTGRES_PASSWORD=wonder

# =========================
# RabbitMQ
# =========================

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=wonder
RABBITMQ_PASSWORD=s3cr3t!

# =========================
# MinIO
# =========================

MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=wonder
MINIO_SECRET_KEY=wonder-secret
MINIO_BUCKET=wonder-fotos-usuarios

# =========================
# Keycloak
# =========================

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/wonder
KEYCLOAK_JWK_SET_URI=http://keycloak:8080/realms/wonder/protocol/openid-connect/certs
KC_HOSTNAME=http://localhost:8081
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=wonder
KEYCLOAK_CLIENT_ID=wonder-core
KEYCLOAK_CLIENT_SECRET=secret

# SMTP local (MailHog). Para SMTP externo, ajuste os valores conforme o provedor.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=nao-responda@wonder.local
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025
