# =========================
# Spring
# =========================

CORE_SPRING_SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=development
APP_PUBLIC_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8081

# =========================
# PostgreSQL
# =========================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wonder_db
POSTGRES_USER=wonder
POSTGRES_PASSWORD=wonder

# =========================
# RabbitMQ
# =========================

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=wonder
RABBITMQ_PASSWORD=s3cr3t!

# =========================
# MinIO
# =========================

MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=wonder
MINIO_SECRET_KEY=wonder-secret
MINIO_BUCKET=wonder-fotos-usuarios

# =========================
# Keycloak
# =========================

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
