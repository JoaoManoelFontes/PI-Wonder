{
  "realm": "wonder",
  "enabled": true,
  "displayName": "Wonder",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "defaultRole": {
    "name": "default-roles-wonder",
    "description": "${role_default-roles}",
    "composite": true,
    "clientRole": false
  },
  "roles": {
    "realm": [
      {
        "name": "offline_access",
        "description": "${role_offline-access}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "CUSTOMER",
        "description": "Cliente que agenda servicos de beleza"
      },
      {
        "name": "PROVIDER",
        "description": "Prestador que oferece servicos de beleza"
      },
      {
        "name": "ADMIN",
        "description": "Administrador da plataforma Wonder"
      },
      {
        "name": "default-roles-wonder",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "CUSTOMER"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        },
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "wonder-web",
      "name": "Wonder Web",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:8082/*",
        "wonder://auth"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:8082"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      }
    }
  ]
}
